<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify Your Email</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8f9fa;
        margin: 0;
        padding: 20px;
        color: #2d3436;
        line-height: 1.6;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 40px;
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      }
      .header {
        text-align: center;
        margin-bottom: 30px;
      }
      .logo {
        width: 180px;
        margin-bottom: 25px;
      }
      h1 {
        color: #2d3436;
        font-size: 28px;
        font-weight: 600;
        margin: 0 0 15px;
      }
      .welcome-text {
        color: #00b894;
        font-size: 20px;
        margin-bottom: 30px;
      }
      p {
        font-size: 16px;
        color: #636e72;
        margin: 0 0 20px;
        text-align: center;
      }
      .button {
        display: inline-block;
        padding: 15px 35px;
        background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
        color: white !important;
        text-decoration: none;
        font-size: 16px;
        font-weight: 600;
        border-radius: 8px;
        margin: 25px 0;
        transition:
          transform 0.2s,
          box-shadow 0.2s;
        box-shadow: 0 4px 15px rgba(0, 184, 148, 0.2);
      }
      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 184, 148, 0.3);
      }
      .divider {
        height: 1px;
        background-color: #e9ecef;
        margin: 30px 0;
      }
      .footer {
        text-align: center;
        margin-top: 30px;
        padding-top: 20px;
        font-size: 13px;
        color: #a0a0a0;
      }
      .highlight {
        background: linear-gradient(
          120deg,
          rgba(0, 184, 148, 0.2) 0%,
          rgba(0, 184, 148, 0.2) 100%
        );
        padding: 0 5px;
        border-radius: 3px;
      }
      @media (max-width: 600px) {
        body {
          padding: 10px;
        }
        .container {
          padding: 20px;
        }
        h1 {
          font-size: 24px;
        }
        .welcome-text {
          font-size: 18px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Email Verification</h1>
        <div class="welcome-text">
          Welcome to Papdaew, <span class="highlight"><%= username %></span>!
        </div>
      </div>

      <p>
        Thank you for joining Papdaew! To ensure the security of your account
        and access all our features, please verify your email address by
        clicking the button below.
      </p>

      <div style="text-align: center">
        <a href="<%= verificationUrl %>" class="button">Verify Your Email</a>
      </div>

      <div class="divider"></div>

      <div class="footer">
        <p>This verification link will expire in 24 hours.</p>
      </div>
    </div>
  </body>
</html>
